---
import Icon from "./Icon.astro";

const SECTIONS = [
  { id: "hero", label: "Home", icon: "house" },
  { id: "quick-facts", label: "Facts", icon: "target" },
  { id: "about", label: "About", icon: "circle-user-round" },
  { id: "metrics", label: "Metrics", icon: "chart-column-big" },
  { id: "experience", label: "Experience", icon: "briefcase" },
  { id: "projects", label: "Projects", icon: "folder-open" },
  { id: "skills", label: "Skills", icon: "brain" },
  { id: "results", label: "Results", icon: "trending-up" },
  { id: "contact", label: "Contact", icon: "mail" },
];
---

<div class="sidenav" data-sidenav>
  {SECTIONS.map(({ id, label, icon }) => (
    <button
      type="button"
      class="sidenav-btn"
      data-target={id}
      title={label}
      aria-label={`Go to ${label} section`}
    >
      <span class="sidenav-label">{label}</span>
      <span class="sidenav-dot"><Icon name={icon} size={14} /></span>
    </button>
  ))}
  <span class="sidenav-line" aria-hidden="true"></span>
</div>

<style>
  .sidenav {
    position: fixed;
    right: 24px;
    top: 50%;
    transform: translateY(-50%);
    z-index: 100;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 14px;
  }
  .sidenav-btn {
    background: none;
    border: none;
    padding: 0;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .sidenav-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: .65rem;
    letter-spacing: .12em;
    color: #f0f4ff;
    text-transform: uppercase;
    white-space: nowrap;
    opacity: 0;
    transform: translateX(8px);
    transition: opacity .25s ease, transform .25s ease;
  }
  .sidenav-btn:hover .sidenav-label,
  .sidenav-btn[data-active] .sidenav-label {
    opacity: 1;
    transform: translateX(0);
  }
  .sidenav-dot {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(255, 255, 255, .03);
    border: 1px solid rgba(255, 255, 255, .08);
    color: #4a5a78;
    flex-shrink: 0;
    transition: background-color .25s, border-color .25s, box-shadow .25s, color .25s;
  }
  .sidenav-btn:hover .sidenav-dot {
    background: rgba(255, 255, 255, .07);
    color: #a8b8d8;
  }
  .sidenav-btn[data-active] .sidenav-dot {
    background: rgba(59, 130, 246, .18);
    border-color: rgba(59, 130, 246, .5);
    box-shadow: 0 0 12px rgba(59, 130, 246, .35), 0 0 24px rgba(59, 130, 246, .15);
    color: var(--blue);
  }
  .sidenav-line {
    position: absolute;
    right: 4px;
    top: 8px;
    bottom: 8px;
    width: 1px;
    background: linear-gradient(to bottom, transparent, rgba(59, 130, 246, .2), transparent);
    z-index: -1;
    pointer-events: none;
  }
  @media (max-width: 900px) { .sidenav { display: none; } }
</style>
