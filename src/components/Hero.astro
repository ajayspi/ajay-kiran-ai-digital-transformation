---
import Icon from "./Icon.astro";
import { P, ROLES } from "../data";
import { IDENTITY } from "../seo";

const CERTS = [
  { label: "HFI Certified User Experience Analyst (CXA)", org: "Human Factors International", color: P.amber, dot: P.amber },
  { label: "Generative AI Mastermind", org: "Outskill", color: P.violet, dot: P.violet },
  { label: "Digital Marketing", org: "Google Digital Garage", color: P.green, dot: P.green },
];

const socials = [
  { icon: "link", href: "https://www.linkedin.com/in/aigrowthandautomationleader/", label: "LinkedIn" },
  { icon: "git-fork", href: "https://github.com/ajayspi", label: "GitHub" },
  { icon: "globe", href: "https://designjoom.com", label: "Website" },
];
---

<section id="hero" class="hero"
  style="background:radial-gradient(ellipse 80% 60% at 50% 0%, rgba(59,130,246,0.08) 0%, transparent 70%)">
  <canvas id="neural-canvas" aria-hidden="true"></canvas>

  <div class="orbits" aria-hidden="true">
    <div class="orbit-ring" style="width:620px;height:620px;border-color:rgba(59,130,246,0.05);animation-duration:44s"></div>
    <div class="orbit-ring" style="width:400px;height:400px;border-color:rgba(124,58,237,0.07);animation-duration:28s;animation-direction:reverse"></div>
    <div class="orbit-ring" style="width:230px;height:230px;border-color:rgba(6,182,212,0.09);animation-duration:16s"></div>
  </div>

  <div class="relative z-10 max-w-6xl mx-auto px-6 grid md:grid-cols-2 gap-16 items-center pt-24 pb-12">
    <div>
      <div class="badge">
        <span class="badge-dot"></span>
        AI GROWTH &amp; DIGITAL TRANSFORMATION LEADER
      </div>

      <h1>
        {/* The explicit space keeps textContent "A V Ajay Kiran" — a bare <br> would
            collapse to "A V AjayKiran" for parsers that read text nodes. */}
        <span style="color:#f0f4ff">A V Ajay</span><br />{" "}
        <span class="text-shimmer">Kiran</span>
      </h1>

      <div class="tw-wrap" data-typewriter data-words={JSON.stringify(ROLES)}>
        <span style="font-family:'Sora',sans-serif" aria-live="polite">
          <span class="text-shimmer tw-text">{ROLES[0]}</span><span class="tw-caret">|</span>
        </span>
      </div>

      <div class="flex flex-wrap gap-3 mt-8">
        <a href="#contact" class="cta-primary"><Icon name="mail" size={14} /> Get in Touch</a>
        <a href="#projects" class="cta-ghost"><Icon name="layers" size={14} /> View Projects</a>
      </div>

      <div class="flex items-center gap-5 mt-8">
        {socials.map(({ icon, href, label }) => (
          <a href={href} target="_blank" rel="noopener noreferrer" title={label}
             aria-label={`${label} — opens in a new tab`} class="social">
            <Icon name={icon} size={18} />
          </a>
        ))}
      </div>
    </div>

    <div class="flex flex-col items-center md:items-end gap-5">
      <div class="photo-wrap">
        <div class="photo-glow"></div>
        <div class="photo">
          <img src="/ajay-kiran.png" alt={`${IDENTITY.name}, ${IDENTITY.descriptor}`}
               width={260} height={320} fetchpriority="high" />
          <div class="photo-caption">
            <div class="photo-name">{IDENTITY.name}</div>
            <div class="photo-role">AI GROWTH LEADER</div>
          </div>
        </div>
        <div class="glass chip chip-l">
          <div class="chip-num" style={`color:${P.blue}`}>14+</div><div>Yrs Exp</div>
        </div>
        <div class="glass chip chip-r">
          <div class="chip-num" style={`color:${P.violet}`}>AI</div><div>Architect</div>
        </div>
      </div>

      <div class="cert-list">
        {CERTS.map(({ label, org, color, dot }) => (
          <div class="glass cert" style={`border:1px solid ${color}22`}>
            <span class="cert-dot" style={`background:${dot};box-shadow:0 0 6px ${dot}`}></span>
            <div>
              <div class="cert-label">{label}</div>
              <div class="cert-org">{org}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <div class="scroll-cue" aria-hidden="true">
    <span style="font-family:'JetBrains Mono',monospace;font-size:.65rem;letter-spacing:.15em">SCROLL</span>
    <Icon name="chevron-down" size={14} />
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .orbits { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; pointer-events: none; }
  .orbit-ring { position: absolute; border-radius: 50%; border: 1px solid; animation: spin-slow linear infinite; }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    border-radius: 999px;
    margin-bottom: 32px;
    background: rgba(59, 130, 246, .08);
    border: 1px solid rgba(59, 130, 246, .2);
    font-family: 'JetBrains Mono', monospace;
    font-size: .7rem;
    color: #6b9fef;
    letter-spacing: .1em;
  }
  .badge-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--blue);
    display: inline-block;
    animation: glow-pulse 2s ease-in-out infinite;
  }
  h1 {
    font-family: 'Sora', sans-serif;
    font-weight: 800;
    font-size: clamp(2.8rem, 6vw, 5rem);
    line-height: 1.05;
    letter-spacing: -.02em;
  }
  .tw-wrap { margin-top: 16px; height: 40px; display: flex; align-items: center; font-size: clamp(1rem, 2.5vw, 1.4rem); font-weight: 600; }
  :global(.tw-caret) { color: var(--blue); font-style: normal; animation: blink 1s step-end infinite; }

  .cta-primary, .cta-ghost {
    display: flex; align-items: center; gap: 8px;
    padding: 12px 24px; border-radius: 999px;
    font-family: 'Sora', sans-serif; font-size: .875rem; font-weight: 600;
    text-decoration: none;
    transition: transform .3s, box-shadow .3s, background-color .3s, border-color .3s, color .3s;
  }
  .cta-primary { background: linear-gradient(135deg, #3b82f6, #7c3aed); color: #fff; }
  .cta-primary:hover { transform: translateY(-2px); box-shadow: 0 16px 40px rgba(59, 130, 246, .4); }
  .cta-ghost { background: rgba(255, 255, 255, .04); border: 1px solid rgba(255, 255, 255, .1); color: #a8b8d8; }
  .cta-ghost:hover { border-color: rgba(59, 130, 246, .4); color: #f0f4ff; }

  .social { color: #6b7fa8; transition: color .2s, transform .2s; }
  .social:hover { color: var(--blue); transform: translateY(-2px); }

  .photo-wrap {
    /* one knob for the whole photo cluster: frame, certs and the two floating chips */
    --pw: clamp(190px, 23vw, 300px);
    animation: float 6s ease-in-out infinite;
    position: relative;
    width: var(--pw);
    margin-inline: auto;
  }
  .photo-glow {
    position: absolute; inset: -30px;
    background: radial-gradient(circle, rgba(59, 130, 246, .18) 0%, rgba(124, 58, 237, .1) 50%, transparent 70%);
    filter: blur(36px);
  }
  .photo {
    position: relative;
    width: 100%;
    aspect-ratio: 13 / 16;
    border-radius: clamp(16px, 2.2vw, 24px);
    overflow: hidden;
    border: 1.5px solid rgba(59, 130, 246, .35);
    box-shadow: 0 0 48px rgba(59, 130, 246, .22), 0 0 100px rgba(124, 58, 237, .12);
  }
  /* object-fit + object-position instead of the old "height:110%" overflow hack: the crop
     becomes one tunable focal point instead of a magic number baked into a transform.
     20% keeps a headshot framed on the face at every container size. */
  .photo img {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    object-position: 50% 20%;
  }
  .photo-caption {
    position: absolute; bottom: 0; left: 0; right: 0;
    padding: clamp(20px, 2.5vw, 28px) 16px 14px;
    background: linear-gradient(to top, rgba(5, 8, 16, .88) 60%, transparent);
  }
  .photo-name { font-family: 'Sora', sans-serif; font-weight: 700; font-size: clamp(.82rem, 1.1vw, .95rem); color: #f0f4ff; }
  .photo-role { font-family: 'JetBrains Mono', monospace; font-size: .62rem; color: #6b9fef; letter-spacing: .1em; margin-top: 2px; }

  .chip {
    position: absolute;
    padding: 8px 12px; border-radius: 12px;
    font-size: .7rem; font-family: 'JetBrains Mono', monospace;
    /* offsets scale with the frame so they never hang off a narrow viewport */
    max-width: 9rem;
  }
  .chip-l { left: calc(-1 * clamp(6px, 2vw, 56px)); top: 20%; border: 1px solid rgba(59, 130, 246, .25); color: #6b9fef; }
  .chip-r { right: calc(-1 * clamp(6px, 1.8vw, 48px)); top: 33%; border: 1px solid rgba(124, 58, 237, .25); color: #a78bfa; }
  .chip-num { font-weight: 800; font-size: 1rem; }
  /* no room to float them on a phone — the hero is already tight at 100vh */
  @media (max-width: 640px) { .chip { display: none; } }

  .cert-list { display: flex; flex-direction: column; gap: 8px; width: var(--pw); margin-inline: auto; }
  .cert { border-radius: 12px; padding: 9px 12px; display: flex; align-items: center; gap: 10px; }
  .cert-dot { width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0; }
  .cert-label { font-family: 'Sora', sans-serif; font-weight: 600; font-size: .7rem; color: #d8e4ff; line-height: 1.35; }
  .cert-org { font-family: 'JetBrains Mono', monospace; font-size: .58rem; color: #4a5a78; margin-top: 2px; }

  .scroll-cue {
    position: absolute; bottom: 32px; left: 50%;
    transform: translateX(-50%);
    display: flex; flex-direction: column; align-items: center; gap: 4px;
    color: #6b7fa8;
    animation: float 2s ease-in-out infinite;
  }
</style>
